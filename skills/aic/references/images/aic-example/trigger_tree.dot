digraph TriggerTree {
    graph [label="Example: one policy with nested triggers" labelloc=t fontsize=16 fontname="Arial"
           rankdir=TB pad=0.4 nodesep=0.5 ranksep=0.6 ordering=out]
    node [shape=box style="filled,rounded" fontname="Arial" fontsize=11 fillcolor="#B5FFFF" width=1.2]
    edge [fontname="Arial" fontsize=10]

    start [label="Start trigger\n(stored on the policy)" shape=oval fillcolor="#C9E7B7"]
    t1 [label="Trigger 1"] t2 [label="Trigger 2"] t3 [label="Trigger 3"] t8 [label="Trigger 8"]
    t5 [label="Trigger 5"] t4 [label="Trigger 4"] t6 [label="Trigger 6"] t7 [label="Trigger 7"]
    t9 [label="Trigger 9"] t10 [label="Trigger 10"]

    { rank=same; t1; t2; t3; t8 }
    start -> t1
    t1 -> t2 [label=" Next" color="#333333"]
    t2 -> t3 [label=" Next" color="#333333"]
    t3 -> t8 [label=" Next" color="#333333"]

    t1 -> t5 [label=" Then" color="#2E7D32" fontcolor="#2E7D32"]
    t1 -> t4 [label=" Else" color="#C62828" fontcolor="#C62828"]
    t4 -> t7 [label=" Then" color="#2E7D32" fontcolor="#2E7D32"]
    t4 -> t6 [label=" Else" color="#C62828" fontcolor="#C62828"]
    t8 -> t10 [label=" Then" color="#2E7D32" fontcolor="#2E7D32"]
    t8 -> t9 [label=" Else" color="#C62828" fontcolor="#C62828"]
}
